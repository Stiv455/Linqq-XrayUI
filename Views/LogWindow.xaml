<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LinqqXrayVPN.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Bind Loc.GetString('set4.19'), Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Log text area -->
        <ScrollViewer x:Name="LogScrollViewer"
                      Grid.Row="0"
                      Padding="12,12,12,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogTextBlock"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="12"
                       IsTextSelectionEnabled="True"
                       TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </ScrollViewer>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Status -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="{x:Bind Loc.GetString('set4.10'), Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LineCountText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="LogPrivacyButton"
                            Padding="8,5"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('set4.9'), Mode=OneWay}">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutSubItem Text="{x:Bind Loc.GetString('set4.11'), Mode=OneWay}">
                                    <RadioMenuFlyoutItem x:Name="MaskOffMenuItem"
                                                         Text="{x:Bind Loc.GetString('set4.12'), Mode=OneWay}"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag=""
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskQuarterMenuItem"
                                                         Text="{x:Bind Loc.GetString('set4.13'), Mode=OneWay}"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="quarter"
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskHalfMenuItem"
                                                         Text="{x:Bind Loc.GetString('set4.14'), Mode=OneWay}"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="half"
                                                         Click="MaskAddressMenuItem_Click" />
                                    <RadioMenuFlyoutItem x:Name="MaskFullMenuItem"
                                                         Text="{x:Bind Loc.GetString('set4.15'), Mode=OneWay}"
                                                         GroupName="LogMaskAddressGroup"
                                                         Tag="full"
                                                         Click="MaskAddressMenuItem_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="AutoScrollToggle"
                                  IsChecked="True"
                                  Content="{x:Bind Loc.GetString('set4.16'), Mode=OneWay}"
                                  FontSize="12"
                                  Padding="10,5" />
                    <Button x:Name="CopyButton"
                            Content="{x:Bind Loc.GetString('set4.17'), Mode=OneWay}"
                            FontSize="12"
                            Padding="10,5"
                            Click="CopyButton_Click" />
                    <Button x:Name="ClearButton"
                            Content="{x:Bind Loc.GetString('set4.18'), Mode=OneWay}"
                            FontSize="12"
                            Padding="10,5"
                            Click="ClearButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
