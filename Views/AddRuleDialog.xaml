<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LinqqXrayVPN.Views.AddRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind Loc.GetString('add_pravilo'), Mode=OneWay}"
    PrimaryButtonText="{x:Bind Loc.GetString('add'), Mode=OneWay}"
    CloseButtonText="{x:Bind Loc.GetString('cancel'), Mode=OneWay}"
    DefaultButton="Primary">
 
    <StackPanel Spacing="16" MinWidth="320">

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Loc.GetString('tip'), Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="TypeComboBox"
                      SelectedIndex="0"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{x:Bind Loc.GetString('domain'), Mode=OneWay}" Tag="domain" />
                <ComboBoxItem Content="{x:Bind Loc.GetString('ip'), Mode=OneWay}"             Tag="ip" />
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Loc.GetString('set1.1'), Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="MatchTextBox"
                     PlaceholderText="{x:Bind Loc.GetString('set1.2'), Mode=OneWay}" />
            <TextBlock Text="{x:Bind Loc.GetString('set1.3'), Mode=OneWay}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Loc.GetString('tip'), Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="OutboundComboBox"
                      SelectedIndex="0"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{x:Bind Loc.GetString('set2.1'), Mode=OneWay}"  Tag="proxy" />
                <ComboBoxItem Content="{x:Bind Loc.GetString('set2.2'), Mode=OneWay}" Tag="direct" />
                <ComboBoxItem Content="{x:Bind Loc.GetString('set2.3'), Mode=OneWay}"  Tag="block" />
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Text="{x:Bind Loc.GetString('set2.4'), Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="11"
                   Visibility="Collapsed" />

    </StackPanel>
</ContentDialog>
