<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="LinqqXrayVPN.Views.PersonalizeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="using:LinqqXrayVPN.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20"
                    Padding="0,0,12,24">
            
            <!-- ── Header ──────────────────────────────────────────────────── -->
            <TextBlock Text="{x:Bind Loc.GetString('set6.0'), Mode=OneWay}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />

            <!-- ── Theme ───────────────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Loc.GetString('set6.1'), Mode=OneWay}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Loc.GetString('set6.2'), Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <controls:Segmented HorizontalAlignment="Left"
                                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <controls:Segmented.Resources>
                        <!-- Remove hover highlight — gap between hover fill and outer border looks off -->
                        <SolidColorBrush x:Key="SegmentedItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SegmentedItemBorderBrushPointerOver" Color="Transparent" />
                    </controls:Segmented.Resources>
                    <controls:SegmentedItem Content="{x:Bind Loc.GetString('set6.9'), Mode=OneWay}"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                    <controls:SegmentedItem Content="{x:Bind Loc.GetString('set6.10'), Mode=OneWay}"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE708;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                    <controls:SegmentedItem Content="{x:Bind Loc.GetString('set6.11'), Mode=OneWay}"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE770;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                </controls:Segmented>
            </StackPanel>
            <!-- ── Backdrop ────────────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Loc.GetString('set6.3'), Mode=OneWay}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Loc.GetString('set6.4'), Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ComboBox HorizontalAlignment="Left"
                          MinWidth="160"
                          SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind Loc.GetString('set6.5'), Mode=OneWay}" />
                    <ComboBoxItem Content="{x:Bind Loc.GetString('set6.6'), Mode=OneWay}" />
                </ComboBox>
            </StackPanel>
            <!-- ── Protocol Colors ─────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="2">
                        <TextBlock Text="{x:Bind Loc.GetString('set6.7'), Mode=OneWay}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Loc.GetString('set6.8'), Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.ResetColorsCommand}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            VerticalAlignment="Center"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon Glyph="&#xE72C;"
                                      FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Loc.GetString('set6.12'), Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Main protocols card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel>

                        <!-- Shadowsocks / SS -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Grid.Column="0"
                                      Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Data="M17,1.042 L11.436,14.954 L7.958,11.477 L8.653,13.563 L7.03,14.958 L7.03,11.563 L14.984,3.375 L6.047,9.969 L1,8.694 L17,1.042 Z" />
                            <TextBlock Grid.Column="1"
                                       Text="Shadowsocks / SS"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.SsColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.SsColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.SsColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- VLESS -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81E;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="VLESS"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.VlessColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.VlessColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.VlessColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- VMess -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE909;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="VMess"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.VmessColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.VmessColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.VmessColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- Hysteria 2 -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE945;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Hysteria 2"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.Hysteria2Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.Hysteria2Color, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{x:Bind ViewModel.Hysteria2Color, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- (fallback) card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,13"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE8B9;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('set6.13'), Mode=OneWay}"
                                       FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('set6.14'), Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind ViewModel.FallbackColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <ColorPicker Color="{x:Bind ViewModel.FallbackColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False"
                                                     IsHexInputVisible="True"
                                                     IsAlphaTextInputVisible="False"
                                                     IsMoreButtonVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.FallbackColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                       FontSize="13"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind Loc.GetString('set6.15'), Mode=OneWay}"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <Expander.Header>
                        <Grid Padding="0,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE946;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('set6.16'), Mode=OneWay}"
                                           FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('set6.17'), Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="-16,-12,-16,-12">
                        <!-- Delay Display -->
                        <CheckBox IsChecked="{x:Bind ViewModel.ShowLatencyInDetails, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Margin="42,10,16,10">
                            <StackPanel VerticalAlignment="Center"
                                    Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('set6.18'), Mode=OneWay}"
                                       FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('set6.19'), Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
         
                        <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Unlock Display -->
                        <CheckBox IsChecked="{x:Bind ViewModel.ShowUnlockInDetails, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Margin="42,10,16,10">
                            <StackPanel VerticalAlignment="Center"
                                    Spacing="2">
                                <TextBlock Text="{x:Bind Loc.GetString('set6.20'), Mode=OneWay}"
                                       FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('set6.21'), Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Expander>
            </StackPanel>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Margin="0,12,0,0">

                <Grid Padding="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0"
                  Glyph="&#xE8D2;" 
                  FontSize="18"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1"
                    Spacing="2"
                    VerticalAlignment="Center">

                        <TextBlock Text="{x:Bind Loc.GetString('set17.24'), Mode=OneWay}" 
                       FontSize="15"
                       FontWeight="SemiBold" />

                        <TextBlock Text="{x:Bind Loc.GetString('set17.25'), Mode=OneWay}" 
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

                      <ComboBox
                      ItemsSource="{x:Bind ViewModel.SupportedLanguages, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0"
                      HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:LanguageOption">
                                    <TextBlock Text="{x:Bind DisplayName}" 
                                   FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Loc.GetString('set6.22'), Mode=OneWay}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Loc.GetString('set6.23'), Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,13"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xEDE1;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="{x:Bind Loc.GetString('set6.24'), Mode=OneWay}"
                                       FontSize="14" />
                            <TextBlock Text="{x:Bind Loc.GetString('set6.25'), Mode=OneWay}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Padding="12,6"
                                Click="ExportPresetButton_Click">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE898;"
                                          FontSize="14" />
                                <TextBlock Text="{x:Bind Loc.GetString('set6.29'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
                <InfoBar x:Name="ExportSuccessInfoBar"
                         IsOpen="False"
                         Severity="Success"
                         Title="{x:Bind Loc.GetString('set6.26'), Mode=OneWay}"
                         Message="{x:Bind Loc.GetString('set6.27'), Mode=OneWay}"
                         IsClosable="True" />
            </StackPanel>

            <!-- ── Footer ──────────────────────────────────────────────────── -->
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.DoneCommand}"
                    MinWidth="88"
                    Content="{x:Bind Loc.GetString('set6.28'), Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
