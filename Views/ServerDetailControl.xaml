<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="LinqqXrayVPN.Views.ServerDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LinqqXrayVPN.Controls"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">
    

    <Grid >
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
            <TextBlock Grid.Row="0"
                   Text="{x:Bind Loc.GetString('set7.1'), Mode=OneWay}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

            <StackPanel Orientation="Vertical"
                    Grid.Row="1"
                    Spacing="8"
                    Padding="0,0,12,80">
                <Border 
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                <Grid>
                    <StackPanel Orientation="Vertical"
                                Spacing="12">
                        <Grid 
                              ColumnSpacing="12"
                              RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{x:Bind Loc.GetString('set7.2'), Mode=OneWay}"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="{x:Bind Loc.GetString('set7.3'), Mode=OneWay}"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedProtocol, Mode=OneWay}"
                                       FontSize="16"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="{x:Bind Loc.GetString('set7.4'), Mode=OneWay}"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedHost, Mode=OneWay}"
                                       FontSize="16"
                                       TextWrapping="WrapWholeWords" />

                            <TextBlock Text="{x:Bind Loc.GetString('set7.5'), Mode=OneWay}"
                                       Grid.Row="3"
                                       Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedPort, Mode=OneWay}"
                                       FontSize="16" />
                         
                            <TextBlock Text="{x:Bind ViewModel.SelectedSecurityLabel, Mode=OneWay}"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedEncryption, Mode=OneWay}"
                                       FontSize="16" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="{x:Bind Loc.GetString('set7.6'), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedTransport, Mode=OneWay}"
                                       FontSize="16" />

                            <!-- Row 6: VLESS encryption (PQ) — VLESS only, hidden if empty -->
                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="{x:Bind Loc.GetString('set7.7'), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.VlessEncryptionVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Row="6"
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.SelectedVlessEncryption, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedVlessEncryption, Mode=OneWay}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.VlessEncryptionVisibility, Mode=OneWay}" />

                            <!-- Row 7: ECH - VLESS + TLS only, hidden if empty -->
                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Text="{x:Bind Loc.GetString('set7.8'), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.EchVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Row="7"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedEch, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedEch, Mode=OneWay}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.EchVisibility, Mode=OneWay}" />
                        </Grid>

                        <!-- Services -->
                        <StackPanel Spacing="12"
                                    Margin="0,2,0,0"
                                    Visibility="{x:Bind ViewModel.UnlockVisibility, Mode=OneWay}">
                            <Grid x:Name="AIShadowCastGrid" />
                            <TextBlock Text="{x:Bind Loc.GetString('set7.9'), Mode=OneWay}"
                                           FontSize="13"                                          
                                           CharacterSpacing="80"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />

                            <Grid ColumnSpacing="12" 
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- youtube -->
                                <Border Grid.Column="0"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"                                      
                BorderThickness="0.8"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Translation="0,0,16" Loaded="ShadowRect_Loaded"
                Width="110"
                Padding="14,12">
                                    <Border.Shadow>
                                        <ThemeShadow x:Name="Shadow1"/>
                                    </Border.Shadow>

                                    <Grid RowDefinitions="Auto,*,Auto"
                  MinHeight="52">
                                        <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto">
                                            <Viewbox Grid.Column="0"
                             Width="22"
                             Height="22"
                             HorizontalAlignment="Left">
                                                <ImageIcon Source="/Assets/icons/youtube.png" />
                                            </Viewbox>
                                            <Ellipse Grid.Column="2"
                             Width="6"
                             Height="6"
                             Fill="{x:Bind ViewModel.OpenAiStatusBrush, Mode=OneWay}"
                             VerticalAlignment="Top"
                             Margin="0,2,0,0" />
                                        </Grid>
                                        <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      Margin="0,10,0,0"
                      VerticalAlignment="Bottom">
                                            <TextBlock Text="YouTube"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                            Click="AiLinkButton_Click"
                            Tag="https://www.youtube.com"
                            ToolTipService.ToolTip="{x:Bind Loc.GetString('set7.10'), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Loc.GetString('set7.10'), Mode=OneWay}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Padding="0"
                            Width="16"
                            Height="16"
                            MinWidth="16"
                            MinHeight="16"
                            Margin="0,0,-4,0"
                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                                                <FontIcon Glyph="&#xE8A7;"
                                  Margin="0,0,-2,0"
                                  FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- telegram -->

                                <Border Grid.Column="1"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            BorderThickness="0.8"
            Translation="0,0,16" Loaded="ShadowRect_Loaded"
            Width="110"
            Padding="14,12">
                                    <Border.Shadow>
                                        <ThemeShadow x:Name="Shadow2"/>
                                    </Border.Shadow>
                                    <Grid RowDefinitions="Auto,*,Auto"
                    MinHeight="52">
                                        <Grid Grid.Row="0"
                        ColumnDefinitions="Auto,*,Auto">
                                            <Viewbox Grid.Column="0"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Left">
                                                <Grid Width="24"
                            Height="24">
                                                    <ImageIcon Source="/Assets/icons/telegram.png" />
                                                </Grid>
                                            </Viewbox>
                                            <Ellipse Grid.Column="2"
                        Width="6"
                        Height="6"
                        Fill="{x:Bind ViewModel.ClaudeStatusBrush, Mode=OneWay}"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0" />
                                        </Grid>
                                        <Grid Grid.Row="2"
        ColumnDefinitions="*,Auto"
        Margin="0,10,0,0"
        VerticalAlignment="Bottom">
                                            <TextBlock Text="Telegram"
        FontSize="12"
        FontWeight="SemiBold"
        VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
        Click="AiLinkButton_Click"
        Tag="https://web.telegram.org/a/"
        ToolTipService.ToolTip="{x:Bind Loc.GetString('set7.11'), Mode=OneWay}"
        AutomationProperties.Name="{x:Bind Loc.GetString('set7.11'), Mode=OneWay}"
        Background="Transparent"
        BorderBrush="Transparent"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Padding="0"
        Width="16"
        Height="16"
        MinWidth="16"
        MinHeight="16"
        Margin="0,0,-4,0"
        HorizontalContentAlignment="Right"
        VerticalContentAlignment="Center"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom">
                                                <FontIcon Glyph="&#xE8A7;"
                                Margin="0,0,-2,0"
                                FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>


                                <!-- Discord -->
                                <Border Grid.Column="2"
                                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    BorderThickness="0.8"
                                    Translation="0,0,16" Loaded="ShadowRect_Loaded"
                                    Width="110"
                                    Padding="14,12">
                                
                                <Border.Shadow>
                                <ThemeShadow x:Name="Shadow3"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,*,Auto"
                                    MinHeight="52">
                                        <Grid Grid.Row="0"
                                            ColumnDefinitions="Auto,*,Auto">
                                                <Viewbox Grid.Column="0"
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Left">
                                                <Grid Width="24"
                                                    Height="24">
                                                    <ImageIcon Source="/Assets/icons/discord.png" />
                                                </Grid>
                                            </Viewbox>
                                            <Ellipse Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                Fill="{x:Bind ViewModel.GeminiStatusBrush, Mode=OneWay}"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0" />
                                                </Grid>
                                        <Grid Grid.Row="2"
                                            ColumnDefinitions="*,Auto"
                                            Margin="0,10,0,0"
                                            VerticalAlignment="Bottom">
                                            <TextBlock Text="Discord"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                Click="AiLinkButton_Click"
                                                Tag="https://discord.com/"
                                                ToolTipService.ToolTip="{x:Bind Loc.GetString('set7.12'), Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind Loc.GetString('set7.12'), Mode=OneWay}"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Padding="0"
                                                Width="16"
                                                Height="16"
                                                MinWidth="16"
                                                MinHeight="16"
                                                Margin="0,0,-4,0"
                                                HorizontalContentAlignment="Right"
                                                VerticalContentAlignment="Center"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                                <FontIcon Glyph="&#xE8A7;"
                                                    Margin="0,0,-2,0"
                                                    FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </Grid>
                        </StackPanel>
                        <!-- Latency row -->
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.LatencyVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Loc.GetString('set6.18'), Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}"                                   
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <Button x:Name="RetestLatencyButton"
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.TestLatencyCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanTestLatency, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="8"
                                    AutomationProperties.Name="{x:Bind Loc.GetString('set8.16'), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.GetString('set8.16'), Mode=OneWay}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE895;"
                                          FontSize="14" />
                            </Button>
                        </Grid>

                    </StackPanel>
                    <controls:CopyButton HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Padding="7,6,7,6"
                                         MinWidth="32"
                                         MinHeight="32"
                                         Content="&#xE8C8;"
                                         AutomationProperties.Name="{x:Bind Loc.GetString('set7.13'), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind Loc.GetString('set7.13'), Mode=OneWay}"
                                         TextToCopy="{x:Bind ViewModel.SelectedShareLink, Mode=OneWay}" />
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
